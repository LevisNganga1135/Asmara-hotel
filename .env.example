# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:5500,https://asmara-hotel.vercel.app

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/hotel_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD= YourNewPassword123!
DB_NAME=hotel_db
DB_CONNECTION_LIMIT=20

# Authentication / JWT
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Staff Registration Secret
# Supply this value in the X-Registration-Secret request header when calling
# POST /api/auth/register to create new staff accounts.
# Leave this unset to DISABLE staff registration entirely (recommended in production).
REGISTRATION_SECRET=change_this_to_a_long_random_secret

# Safaricom Lipa Na M-Pesa API Settings
MPESA_CONSUMER_KEY=your_safaricom_consumer_key
MPESA_CONSUMER_SECRET=your_safaricom_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=https://your-public-domain.example.com/api/payments/callback
MPESA_CALLBACK_SECRET=your_secure_merchant_token_here
MPESA_TIMEOUT_MS=30000

# Admin Seed Credentials
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=Password123!
